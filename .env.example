# ============================================================================
# Enterprise Payments AI Platform - Environment Template
# ============================================================================
# Copy this file to `.env` at the repository root for host-side Python
# services (ingestion, AI). Docker infrastructure uses
# `infrastructure/docker/.env`.
#
#   cp .env.example .env
#
# NOTE: Values below are DEVELOPMENT credentials only.
# ============================================================================

# --- MinIO (host-side connection) -------------------------------------------
# Host processes talk to MinIO on localhost; in-network containers use minio:9000
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION=eu-west-2
MINIO_USE_SSL=false
MINIO_RAW_BUCKET=epap-raw
MINIO_STAGING_BUCKET=epap-staging
MINIO_BRONZE_BUCKET=epap-bronze
MINIO_SILVER_BUCKET=epap-silver
MINIO_GOLD_BUCKET=epap-gold

# --- Sample data location ---------------------------------------------------
SAMPLES_DIR=data/samples
